      "resource": "vllm.kv-offload.secondary-tier.hust-fs",
      "scope": "vllm-process",
      "mode": "exclusive"
    }
  ],
  "activation": {
    "entry_points": [
      {
        "group": "vllm.general_plugins",
        "name": "hust_kv_tiering"
      }
    ],
    "environment": {},
    "additional_config": {}
  }
