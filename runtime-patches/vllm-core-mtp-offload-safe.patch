+class SupportsNonuniformHybridLocalHits(ABC):
+    """Explicit, request-scoped permission to omit local recurrent-state hits.
+
+    HMA support alone does not provide this guarantee. Default is fail-closed.
+    Opt in only when a validated transfer plan restores every omitted state
+    before model execution, even when external token delta would be zero.
+    Ordinary local requests and rejected/absent transfer plans must return False.
+    """
+
+    def can_use_nonuniform_hybrid_local_hits(self, request: "Request") -> bool:
+        return False
+
